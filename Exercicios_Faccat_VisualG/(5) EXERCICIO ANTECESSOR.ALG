Algoritmo "EXERCICIO ANTECESSOR"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson Costa Dos Santos
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Daniel De Souza
// Data atual  : 19/09/2026
Var
// Seção de Declarações das variáveis 
    valor: inteiro
    antecessor: inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
    Escreval(" Bem vindo ao programa antecessor")
    Escreval("Digite algum valor:")
    leia(valor)
    Escreval("Agora vamos ver o antessor do valor digitado")
    Escreval("...")
    antecessor<- valor - 1
    Escreval("O Antecessor de ", valor, "= ", "é", antecessor)
    
    

Fimalgoritmo