Algoritmo "Conversão de Graus FAHRENHEINT PARA CELSIUS"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson COstas dos Santos
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Daniel De Souza
// Data atual  : 13/09/2026
Var
// Seção de Declarações das variáveis
    grauscelsius: real
    grausfarenheint: real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
     Escreval("Conversão de Temperatura de Graus Celsius Para Farenheint")
     Escreval("")
     Escreval("")
     Escreval("")
     Escreval("")
     timer 900
     Escreval("Digite Uma temperatura em graus celsius:")
     Leia(grauscelsius)
     Escreval("Ok ótima escolha agora vamos converter para graus farenheint")
     grausfarenheint := (grauscelsius * 9 / 5) + 32
     escreval("Temperatura coinvertida em farenheint é : ", grausfarenheint)
Fimalgoritmo