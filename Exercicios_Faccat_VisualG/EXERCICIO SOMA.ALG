Algoritmo "Exercicio Soma"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson Costas Dos Santos
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Daniel De Souza
// Data atual  : 19/09/2026
Var
// Seção de Declarações das variáveis 
     soma: real
     numeroum: real
     numerodois: real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
      Escreval(" bem vindo ao programa de soma")
      Escreval("Porfavor Digite um numero:")
      Leia(numeroum)
      Escreval("Otimo agora escreva outro numero")
      leia(numerodois)
      Escreval("Otimo agora vamos reallizar a soma deles dois")
      Escreval("...")
      soma<- numeroum + numerodois
      Escreval("O resultado da sua soma é:",soma)
      

Fimalgoritmo