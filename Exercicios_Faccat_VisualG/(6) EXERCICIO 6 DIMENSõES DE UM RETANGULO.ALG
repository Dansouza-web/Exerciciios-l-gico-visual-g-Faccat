Algoritmo "Dimensões de um retangulo"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson Costa Dos Santos
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Daniel De Souza
// Data atual  : 19/09/2026
Var
// Seção de Declarações das variáveis 
    base: real
    altura: real
    area :real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
       Escreval("Escreva um algoritmo para ler as dimensões de um retângulo (base e altura), calcular e escrever a")
       Escreval("área do retângulo.")
       Escreval("Digite a base do seu retangulo")
       leia(base)
       Escreval("Agora Escreva a altura de seu retangulo")
       leia(altura)
       Escreval("Agora vamos calcular a area")
       area<- base * altura
       Escreval("A area do retangulo é", base, "X" , altura, "=", area)
       
       


Fimalgoritmo