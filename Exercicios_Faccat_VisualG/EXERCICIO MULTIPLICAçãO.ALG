Algoritmo "Exercicio Multiplicação"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson Costas Dos Santos
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Daniel De Souza
// Data atual  : 19/09/2026
Var
// Seção de Declarações das variáveis
     multiplicacao: real
     numeroum: real
     numerodois: real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
      Escreval(" bem vindo ao programa de multiplicacao")
      Escreval("Porfavor Digite um numero:")
      Leia(numeroum)
      Escreval("Otimo agora escreva outro numero")
      leia(numerodois)
      Escreval("Otimo agora vamos reallizar a multiplicaçao deles dois")
      Escreval("...")
      multiplicacao<- numeroum * numerodois
      Escreval("O resultado da sua multiplicacao é:",multiplicacao)


Fimalgoritmo